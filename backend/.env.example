# Leave empty for direct local access. Only set after a verified egress policy protects Chromium.
LOWBAND_EGRESS_ISOLATION=

# Optional exact frontend origin when it is hosted separately from the API.
LOWBAND_FRONTEND_ORIGIN=

# Optional comma-separated trusted proxy IPs/CIDRs; leave empty for direct local access.
LOWBAND_TRUST_PROXY=

# Persistent analysis history file (default: data/analysis-history.json under process.cwd()).
# Use persistent mounted storage; this JSON adapter is for one backend instance.
LOWBAND_HISTORY_FILE=

# Local listener settings
HOST=127.0.0.1
PORT=3001
